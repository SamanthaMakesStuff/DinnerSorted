# --- Database (P1 accounts) ---------------------------------------------
# Pooled Postgres connection string from Neon or Supabase.
#   Neon:     use the "Pooled connection" string from the dashboard
#   Supabase: use the "Transaction pooler" string (port 6543)
# The app runs fine WITHOUT this (guest mode + JSON export/import only);
# sign-in and server-side persistence simply stay disabled.
DATABASE_URL=

# --- Auth.js (P1 accounts) ------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to your deployed URL in production, e.g. https://dinnersorted.vercel.app
# (Vercel usually infers this; set it explicitly if sign-in redirects misbehave.)
# AUTH_URL=
